{
  "_version": "1.85.0",
  "sap.app": {
    "id": "ui5project",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.27.0",
      "toolsId": "935979e9-d4d6-4f16-95e0-0f5f5ebeffd9"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/my/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml", 
          "odataVersion": "4.0" 
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "UI5Semantic-UI5action": {
          "semanticObject": "UI5Semantic",
          "action": "UI5action",
          "title": "{{UI5Semantic-UI5action.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.149.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "ui5project.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "ui5project.view",
        "async": true,
        "viewPath": "ui5project.view"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": "",
          "target": [
            "TargetMain"
          ]
        },
         {
          "name": "RouteButton",
          "pattern": "Button",
          "target": [
            "TargetButton"
          ]
        },{
          "name": "JsonModelDataBinding",
          "pattern": "JsonModelDataBinding",
          "target": [
            "TargetJsonModelDataBinding"
          ]
        },
        {
          "name": "OdataModelDataBinding",
          "pattern": "OdataModelDataBinding",
          "target": [
            "TargetOdataModelDataBinding"
          ]
        }
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "Main"
        },
        "TargetButton": {
          "id": "Button",
          "name": "Button"                      
        },
        "TargetJsonModelDataBinding": {
          "id": "JsonDataBinding",
          "name": "DataBinding"
        },
        "TargetOdataModelDataBinding":{
           "id": "OdataBinding",
          "name": "ODataModelBinding"

        }
      }
    },
    "rootView": {
      "viewName": "ui5project.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}


