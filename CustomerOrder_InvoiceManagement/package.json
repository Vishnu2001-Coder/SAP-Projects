{
  "name": "CustomerOrder_InvoiceManagement",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4.7.0",
    "@sap-cloud-sdk/http-client": "^4.7.0",
    "@sap-cloud-sdk/resilience": "^4.7.0",
    "@sap/approuter": "^22.0.1",
    "@sap/cds": "^9.9.1",
    "@sap/cds-dk": "^9.9.1",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-products": "cds watch --open products/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-order": "cds watch --open order/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-customers": "cds watch --open customers/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-invoice": "cds watch --open invoice/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/products",
    "app/products",
    "app/order",
    "app/customers",
    "app/invoice"
  ],
  "cds": {
    "server": {
      "index": true
    },
    "requires": {
      "API_PRODUCT_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_PRODUCT_SRV",
        "credentials": {
          "url": "https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_PRODUCT_SRV",
          "headers": {
            "APIKey": "12dLMOH6G35JxCvO5kYjFC2axBu1fP55"
          }
        }
      },
      "InvoiceApi": {
        "kind": "rest",
        "credentials": {
          "destination": "Invoice_Destination"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    }
  }
}
